# Drizzle / Postgres connection string.
DATABASE_URL="postgresql://autoreverse:autoreverse@localhost:5434/autoreverse"

# Base directory for server-managed files (covers, downloaded podcast episodes). Optional, defaults to ./data.
AUTOREVERSE_DATA="./data"

# First-admin bootstrap: only used once, the first time the server starts against an empty `users` table.
AUTOREVERSE_ADMIN_USER="admin"
AUTOREVERSE_ADMIN_PASSWORD="change-me"

# Public URL of the server, as the browser sees it. Only needed when a reverse proxy
# terminates TLS in front of Autoreverse — without it, form POSTs (the web UI login)
# are rejected with "Cross-site POST form submissions are forbidden". Not used by
# `vite dev`, which serves the browser directly.
# ORIGIN="https://autoreverse.example.com"

# How often the server refreshes every podcast feed and applies the download retention, in hours.
# 0 turns the background job off.
AUTOREVERSE_PODCAST_REFRESH_HOURS="6"
