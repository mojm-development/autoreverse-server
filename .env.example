# Read by the server at start (dotenvy). Variables already set in the environment win.
#
# Postgres connection string. Under `cargo run` / `cargo test`, .cargo/config.toml already sets
# this to the compose Postgres below, and that wins over this file — export DATABASE_URL in the
# shell to point a cargo-started server elsewhere.
DATABASE_URL="postgresql://autoreverse:autoreverse@localhost:5434/autoreverse"

# Base directory for server-managed files: covers/, artists/ and podcasts/ (downloaded episodes,
# one folder per podcast). Optional, defaults to ./data.
AUTOREVERSE_DATA="./data"

# First-admin bootstrap: only used while the `users` table is empty. Later password resets:
# `autoreverse-server set-password <name> --admin` (or `make password NAME=…`).
AUTOREVERSE_ADMIN_USER="admin"
AUTOREVERSE_ADMIN_PASSWORD="change-me"

# Public URL of the server, as the browser sees it, without a trailing slash. Needed when a
# reverse proxy terminates TLS in front of Autoreverse: without it, web form POSTs (the login)
# are rejected with "Cross-site POST form submissions are forbidden", and session cookies only
# get the Secure flag when this starts with https://.
# ORIGIN="https://autoreverse.example.com"

# Comma-separated addresses or networks of reverse proxies whose X-Forwarded-For is believed. Set
# it behind a proxy: only then does the login throttle see individual clients. The proxy must
# overwrite or append that header itself.
# AUTOREVERSE_TRUSTED_PROXIES="172.18.0.0/16"

# Optional language-model suggestions (playlists, what to hear next, new artists). Unset: off.
# Album, artist and track names are sent to the provider; audio files and accounts are not.
# AUTOREVERSE_AI_PROVIDER="anthropic"   # or "ollama"
# AUTOREVERSE_AI_API_KEY=""             # anthropic only
# AUTOREVERSE_AI_MODEL=""               # required for ollama, default for anthropic: claude-haiku-5-5
# AUTOREVERSE_AI_URL=""                 # default for ollama: http://localhost:11434

# How often the server refreshes every podcast feed and applies the download retention, in hours.
# 0 turns the background job off.
AUTOREVERSE_PODCAST_REFRESH_HOURS="1"

# How often the library is scanned for new and changed files, in hours. 0 turns it off.
AUTOREVERSE_SCAN_HOURS="1"

# Loudness normalisation: music without ReplayGain/R128 tags is measured in the background after
# a scan (each file is decoded once with ffmpeg). "0" switches the measuring off; tags are still
# read.
AUTOREVERSE_LOUDNESS="1"
# How many albums are decoded at once. Default: half the cores, at most 4.
# AUTOREVERSE_LOUDNESS_THREADS="2"

# Biography, pictures and top tracks of artists come from TheAudioDB and Apple's music
# catalogue; only the artist's name is sent there. "0" keeps the server from asking.
AUTOREVERSE_ARTIST_INFO="1"

# Internet radio stations: each user's list, played through this server. "0" removes the feature
# (routes answer 404, the web UI shows no "Radio").
AUTOREVERSE_RADIO="1"
# Searching stations in the free directory radio-browser.info; only the search words and a
# country code are sent. "0" keeps the server from asking; stations are then added by address.
AUTOREVERSE_RADIO_DIRECTORY="1"
# The directory's base address. The default name resolves to all of its servers; set a single
# one (https://de1.api.radio-browser.info) or a mirror only if you need to.
# AUTOREVERSE_RADIO_DIRECTORY_URL="https://all.api.radio-browser.info"

# Remote control between the devices of an account: see what plays where, steer it, hand playback
# over. Kept in memory only. "0" removes the feature (the /me/devices routes answer 404, the web
# player shows no "Geräte").
AUTOREVERSE_DEVICES="1"

# Where the server listens. Defaults: 0.0.0.0 and 3000.
# HOST="0.0.0.0"
# PORT="3000"

# CSS, JS and icons. Default: `static/` beside the binary, else ./static. The server refuses to
# start if neither has css/app.css.
# AUTOREVERSE_STATIC="/opt/autoreverse/static"

# Log filter (tracing EnvFilter). Default: autoreverse_server=info,tower_http=warn
# RUST_LOG="autoreverse_server=debug,tower_http=info"
